    {
      "name": "Buktikan is_read berubah (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ambil notifikasi 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"notifikasi tadi kini is_read = true\", function () {",
              "  const n = pm.response.json().data.find(x => x.id === pm.environment.get(\"notif_id\"));",
              "  pm.expect(n).to.not.be.undefined;",
              "  pm.expect(n.is_read).to.eql(true);",
