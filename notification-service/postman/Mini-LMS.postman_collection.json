{
  "info": {
    "name": "Mini-LMS Kelompok 2 - Notification",
    "description": "Koleksi uji Notification Service (port 8106). Pilih environment 'Lokal', isi variabel token, lalu jalankan dengan Collection Runner. Urutan request penting: 'Buat notifikasi berhasil' mengisi notif_id yang dipakai request PATCH.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Health 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Format sukses sesuai kontrak\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json).to.have.property(\"data\");",
              "  pm.expect(json.meta).to.have.property(\"request_id\");",
              "});",
              "pm.test(\"status healthy\", function () {",
              "  pm.expect(pm.response.json().data.status).to.eql(\"healthy\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Buat notifikasi berhasil (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Buat notifikasi 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Format sukses sesuai kontrak\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json).to.have.property(\"data\");",
              "  pm.expect(json.meta).to.have.property(\"request_id\");",
              "});",
              "const d = pm.response.json().data;",
              "pm.test(\"Data notifikasi lengkap\", function () {",
              "  pm.expect(d).to.have.property(\"id\");",
              "  pm.expect(d.user_id).to.eql(\"user-001\");",
              "  pm.expect(d.is_read).to.eql(false);",
              "});",
              "pm.environment.set(\"notif_id\", d.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"user-001\",\n  \"message\": \"Submission berhasil diterima\",\n  \"type\": \"submission\",\n  \"submission_id\": \"sub-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
